# From the Slack app: Basic Information > App-Level Tokens (scope connections:write)
SLACK_APP_TOKEN=xapp-...
# From the Slack app: OAuth & Permissions > Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...
# Example only: pnpm run setup creates a .env like this in your profile folder. Owner, repository and review settings belong
# in the generated profile.json. Tokens belong in that profile's .env.
